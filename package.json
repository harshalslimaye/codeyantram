{
  "name": "codeyantram",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:cli": "bun --watch packages/cli/src/index.tsx",
    "dev:server": "cd packages/server && bun run dev",
